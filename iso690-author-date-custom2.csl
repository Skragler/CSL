<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" version="1.0">
  <info>
    <title>Harvard Custom (Name-Date, Uppercase, ISBN)</title>
    <id>http://www.zotero.org/styles/harvard-custom-upper-et-al</id>
    <link href="http://www.zotero.org/styles/harvard-custom-upper-et-al" rel="self"/>
    <author>
      <name>ChatGPT</name>
    </author>
    <category citation-format="author-date"/>
    <category field="generic-base"/>
    <updated>2025-04-13T00:00:00+00:00</updated>
    <summary>Harvard style with first author et al. in-text, uppercase authors in bibliography, and ISBN displayed.</summary>
    <language>en-GB</language>
  </info>

  <macro name="author">
    <names variable="author">
      <name name-as-sort-order="all" and="text" initialize-with=". " delimiter=", ">
        <name-part name="family" text-case="uppercase"/>
        <name-part name="given"/>
      </name>
      <label form="short" prefix=", "/>
      <substitute>
        <names variable="editor"/>
        <text variable="title"/>
      </substitute>
    </names>
  </macro>

  <macro name="issued">
    <date variable="issued">
      <date-part name="year"/>
    </date>
  </macro>

  <macro name="title">
    <text variable="title" font-style="italic"/>
  </macro>

  <macro name="publisher">
    <group delimiter=", ">
      <text variable="publisher"/>
      <text variable="publisher-place"/>
    </group>
  </macro>

  <macro name="isbn">
    <group prefix="ISBN " delimiter="">
      <text variable="ISBN"/>
    </group>
  </macro>

  <citation collapse="year-suffix" et-al-min="2" et-al-use-first="1" et-al-use-last="false">
    <layout prefix="(" suffix=")" delimiter=", ">
      <group delimiter=", ">
        <text macro="author"/>
        <text macro="issued"/>
        <text variable="locator" prefix="p. "/>
      </group>
    </layout>
  </citation>

  <bibliography et-al-min="2" et-al-use-first="1" et-al-use-last="false" hanging-indent="true" line-spacing="2">
    <layout>
      <group delimiter=". ">
        <text macro="author"/>
        <text macro="title"/>
        <text macro="publisher"/>
        <text macro="issued"/>
        <text macro="isbn"/>
      </group>
    </layout>
  </bibliography>
</style>
